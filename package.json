{
  "name": "@weaverse/pilot",
  "version": "2026.10.4",
  "description": "A production-ready Shopify storefront built with Hydrogen and Weaverse",
  "keywords": [
    "ecommerce",
    "hydrogen",
    "hydrogen-theme",
    "react",
    "react-router",
    "shopify",
    "tailwindcss",
    "theme",
    "typescript",
    "weaverse"
  ],
  "homepage": "https://pilot.weaverse.dev",
  "bugs": {
    "url": "https://github.com/weaverse/pilot/issues"
  },
  "license": "MIT",
  "author": "Weaverse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weaverse/pilot.git"
  },
  "directories": {
    "test": "tests"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "shopify hydrogen build --codegen",
    "build:icons": "node ./other/build-icons.mjs",
    "predev": "node ./other/build-icons.mjs",
    "add-icon": "node ./other/add-icon.mjs",
    "dev": "react-router typegen && shopify hydrogen dev --codegen --port 3456",
    "dev:ca": "shopify hydrogen dev --codegen --port 3456 --customer-account-push",
    "preview": "shopify hydrogen preview --build",
    "start": "shopify hydrogen preview",
    "typecheck": "tsc --noEmit",
    "typecheck:ci": "tsrs --noEmit",
    "weaverse:manifest": "node ./other/generate-component-manifest.mjs",
    "weaverse:manifest:check": "node ./other/generate-component-manifest.mjs --check",
    "weaverse:audit": "node ./other/audit-weaverse-settings.mjs",
    "routes-check": "shopify hydrogen check routes",
    "codegen": "shopify hydrogen codegen",
    "hydrogen": "shopify hydrogen",
    "clean": "rm -rf dist node_modules package-lock.json pnpm-lock.yaml .shopify .react-router",
    "test": "playwright test --config=playwright.unit.config.ts",
    "check": "vp check app other public tests codegen.ts env.d.ts package.json playwright.unit.config.ts react-router.config.ts server.ts tsconfig.json virtual-modules.d.ts vite.config.ts",
    "check:fix": "vp check --fix app other public tests codegen.ts env.d.ts package.json playwright.unit.config.ts react-router.config.ts server.ts tsconfig.json virtual-modules.d.ts vite.config.ts",
    "format": "vp fmt --write app other public tests codegen.ts env.d.ts package.json playwright.unit.config.ts react-router.config.ts server.ts tsconfig.json virtual-modules.d.ts vite.config.ts",
    "format:check": "vp fmt --check app other public tests codegen.ts env.d.ts package.json playwright.unit.config.ts react-router.config.ts server.ts tsconfig.json virtual-modules.d.ts vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/cabin": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@graphql-codegen/cli": "7.4.6",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@react-router/dev": "7.16.0",
    "@shopify/hydrogen": "~2026.4.7",
    "@tailwindcss/vite": "^4.3.3",
    "@weaverse/hydrogen": "^5.23.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "colord": "2.10.0",
    "graphql": "16.14.2",
    "isbot": "^5.2.2",
    "react": "19.3.1",
    "react-country-flag": "3.1.0",
    "react-dom": "19.3.1",
    "react-intersection-observer": "11.0.1",
    "react-player": "^3.4.0",
    "react-router": "7.16.0",
    "react-share": "6.1.0",
    "react-use": "17.6.1",
    "schema-dts": "2.1.0",
    "swiper": "^14.3.0",
    "tailwind-merge": "3.7.0",
    "tiny-invariant": "1.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@shopify/cli": "^4.9.4",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "^4.2.3",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@tailwindcss/typography": "0.5.20",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "tailwindcss": "^4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "lodash": "^4.18.1",
    "qs": "^6.16.1",
    "undici": "^7.30.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}
