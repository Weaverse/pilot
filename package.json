{
  "name": "@weaverse/pilot",
  "version": "2026.11.23",
  "description": "A production-ready Shopify storefront built with Hydrogen and Weaverse",
  "keywords": [
    "ecommerce",
    "hydrogen",
    "hydrogen-theme",
    "react",
    "react-router",
    "shopify",
    "tailwindcss",
    "theme",
    "typescript",
    "weaverse"
  ],
  "homepage": "https://pilot.weaverse.dev",
  "bugs": {
    "url": "https://github.com/weaverse/pilot/issues"
  },
  "license": "MIT",
  "author": "Weaverse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weaverse/pilot.git"
  },
  "directories": {
    "test": "tests"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "react-router build",
    "build:icons": "node ./other/build-icons.mjs",
    "predev": "node ./other/build-icons.mjs",
    "add-icon": "node ./other/add-icon.mjs",
    "dev": "hydrogen skills check --mode=warn && vite dev --port 3456",
    "preview": "react-router build && vite preview --port 3456",
    "start": "vite preview --port 3456",
    "typecheck": "react-router typegen && tsc --noEmit && hydrogen gql check --fail-on-warn",
    "typecheck:ci": "react-router typegen && tsrs --noEmit && hydrogen gql check --fail-on-warn",
    "weaverse:manifest": "node ./other/generate-component-manifest.mjs",
    "weaverse:manifest:check": "node ./other/generate-component-manifest.mjs --check",
    "weaverse:audit": "node ./other/audit-weaverse-settings.mjs",
    "hydrogen": "shopify hydrogen",
    "clean": "rm -rf dist node_modules package-lock.json pnpm-lock.yaml .shopify .react-router",
    "test": "playwright test --config=playwright.unit.config.ts",
    "check": "vp check app other public tests env.d.ts package.json playwright.unit.config.ts react-router.config.ts server.ts tsconfig.json virtual-modules.d.ts vite.config.ts",
    "check:fix": "vp check --fix app other public tests env.d.ts package.json playwright.unit.config.ts react-router.config.ts server.ts tsconfig.json virtual-modules.d.ts vite.config.ts",
    "format": "vp fmt --write app other public tests env.d.ts package.json playwright.unit.config.ts react-router.config.ts server.ts tsconfig.json virtual-modules.d.ts vite.config.ts",
    "format:check": "vp fmt --check app other public tests env.d.ts package.json playwright.unit.config.ts react-router.config.ts server.ts tsconfig.json virtual-modules.d.ts vite.config.ts",
    "dev:https": "hydrogen skills check --mode=warn && vite dev --port 3456",
    "deploy": "shopify hydrogen deploy --assets-dir dist/client --worker-dir dist/server"
  },
  "dependencies": {
    "@fontsource-variable/cabin": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-navigation-menu": "1.4.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@react-router/dev": "7.18.6",
    "@shopify/hydrogen": "2026.10.3",
    "@tailwindcss/vite": "4.3.5",
    "@weaverse/hydrogen": "6.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "colord": "2.14.0",
    "graphql": "17.1.0",
    "isbot": "5.2.3",
    "react": "19.3.1",
    "react-country-flag": "3.1.0",
    "react-dom": "19.3.1",
    "react-intersection-observer": "11.0.1",
    "react-player": "3.4.0",
    "react-router": "7.18.6",
    "react-share": "6.1.0",
    "react-use": "17.6.1",
    "schema-dts": "2.1.0",
    "swiper": "14.4.0",
    "tailwind-merge": "3.7.1",
    "tiny-invariant": "1.3.3",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@shopify/cli": "5.0.2",
    "@shopify/mini-oxygen": "4.3.0",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@tailwindcss/typography": "0.5.20",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@weaverse/schema": "0.20.1",
    "eslint": "10.15.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "gql.tada": "1.11.5",
    "tailwindcss": "4.3.5",
    "tsrs": "7.1.0-beta.tsrs2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plus": "1.7.0"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "eslint-plugin-sonarjs": {
      "minimatch": "11.0.9"
    },
    "lodash": "4.18.1",
    "postcss-selector-parser": "6.1.6",
    "qs": "6.17.1",
    "sharp": "0.35.5",
    "undici": "7.30.2",
    "ws": "8.23.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  }
}
