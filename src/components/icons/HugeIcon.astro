---
import {
  Analytics01Icon,
  ArrowDown01Icon,
  ArrowRight01Icon,
  BellIcon,
  BookOpen01Icon,
  BracesIcon,
  Briefcase01Icon,
  ChessKnightIcon,
  Compass01Icon,
  ExternalLinkIcon,
  File01Icon,
  FileCodeIcon,
  Folder01Icon,
  FolderOpenIcon,
  GalleryThumbnailsIcon,
  GlobeIcon,
  KeyboardIcon,
  LandPlotIcon,
  Note01Icon,
  PuzzleIcon,
  QuillWrite02Icon,
  RefreshIcon,
  RobotIcon,
  Rocket01Icon,
  SidebarLeftIcon,
  SidebarRightIcon,
  StarIcon,
  Store01Icon,
  Tag01Icon,
  TerminalIcon,
} from '@hugeicons/core-free-icons'
import { HugeiconsIcon } from '@hugeicons/react'

type IconName =
  | 'analytics'
  | 'bell'
  | 'book'
  | 'braces'
  | 'briefcase'
  | 'caret-down'
  | 'caret-right'
  | 'chess-knight'
  | 'compass'
  | 'external'
  | 'file'
  | 'folder'
  | 'folder-open'
  | 'gallery'
  | 'globe'
  | 'keyboard'
  | 'land-plot'
  | 'markdown'
  | 'puzzle'
  | 'quill'
  | 'refresh'
  | 'robot'
  | 'rocket'
  | 'sidebar-left'
  | 'sidebar-right'
  | 'star'
  | 'store'
  | 'tag'
  | 'terminal'
  | 'code'

interface Props {
  name: IconName
  class?: string
  size?: number
  strokeWidth?: number
  title?: string
}

const {
  name,
  class: className = '',
  size = 16,
  strokeWidth = 1.8,
  title,
} = Astro.props

const ICONS = {
  analytics: Analytics01Icon,
  bell: BellIcon,
  book: BookOpen01Icon,
  braces: BracesIcon,
  briefcase: Briefcase01Icon,
  'caret-down': ArrowDown01Icon,
  'caret-right': ArrowRight01Icon,
  'chess-knight': ChessKnightIcon,
  compass: Compass01Icon,
  external: ExternalLinkIcon,
  file: File01Icon,
  folder: Folder01Icon,
  'folder-open': FolderOpenIcon,
  gallery: GalleryThumbnailsIcon,
  globe: GlobeIcon,
  keyboard: KeyboardIcon,
  'land-plot': LandPlotIcon,
  markdown: Note01Icon,
  puzzle: PuzzleIcon,
  quill: QuillWrite02Icon,
  refresh: RefreshIcon,
  robot: RobotIcon,
  rocket: Rocket01Icon,

  'sidebar-left': SidebarLeftIcon,
  'sidebar-right': SidebarRightIcon,
  star: StarIcon,
  store: Store01Icon,
  tag: Tag01Icon,
  terminal: TerminalIcon,
  code: FileCodeIcon,
} as const
---

<span class:list={['huge-icon', className]} title={title} aria-hidden={title ? undefined : 'true'}>
  <HugeiconsIcon icon={ICONS[name]} size={size} strokeWidth={strokeWidth} />
</span>
